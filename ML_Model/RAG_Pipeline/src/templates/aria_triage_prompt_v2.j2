============================================================
REQUIRED OUTPUT FORMAT: STRUCTURED SOC ANALYST JSON
============================================================

You MUST output ONLY a single, valid JSON object conforming to the schema below.
Ensure the following core SOC triage sections are represented inside the JSON:
- Threat Assessment & Alert Facts -> "incident_summary" and "ai_reasoning"
- Evidence Interpretation -> "evidence_assessment" (observed, supported_by_retrieved_knowledge, not_established)
- Recommended Investigation -> "investigation_priority" (actionable steps with priority, reason, evidence_basis)
- Escalation Recommendation -> "triage_action"
- Evidence Sources -> "rag_threat_intel_context"

Schema:
{
  "triage_action": "{{ escalation_recommendation | default('Tier-1 Investigation / Monitor Host') }}",
  "risk_score": {{ computed_risk_score | default(50) }},
  "mitre_techniques": [
    {% if upstream_mitre_techniques %}
    {% for tech in upstream_mitre_techniques %}
    "{{ tech.split('—')[0].split('-')[0].strip() }}"{% if not loop.last %},{% endif %}
    {% endfor %}
    {% endif %}
  ],
  "iocs_extracted": {
    "agent_name": "{{ parsed_alert.agent_name | default('unknown') }}",
    "agent_ip": "{{ parsed_alert.agent_ip | default('unknown') }}"
  },
  "incident_summary": {
    "what_happened": "<concise summary citing exact Process Name, PID, and Remote IP if present in host context>",
    "why_flagged": [
      "<specific telemetry feature reason 1>",
      "<specific telemetry feature reason 2>",
      "<specific telemetry feature reason 3>"
    ],
    "confidence": "<Moderate or High or Low>"
  },
  "rag_threat_intel_context": [
    {% if retrieved_documents %}
    {% for doc in retrieved_documents[:2] %}
    {
      "source": "{{ doc.source }} ({{ doc.name }})",
      "description": "<grounded description of technique or rule from retrieved knowledge>"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
    {% else %}
    {
      "source": "MITRE_ATTACK",
      "description": "<grounded description of technique from retrieved knowledge>"
    }
    {% endif %}
  ],
  "evidence_assessment": {
    "observed": [
      "<factual telemetry metrics and host context observed directly in alert, citing exact Process Name, PID, and Remote IP if present>"
    ],
    "supported_by_retrieved_knowledge": [
      "<how retrieved knowledge correlates with observed telemetry and host context>"
    ],
    "not_established": [
      "<specific behaviors not established by this alert alone>"
    ]
  },
  "investigation_priority": [
    {
      "priority": 1,
      "action": "<concrete SOC action citing exact Process Name and PID to investigate/terminate, or Remote IP to inspect/block>",
      "reason": "<clear reason for investigation>",
      "evidence_basis": "<Observed Telemetry or Host Context or Retrieved Knowledge>"
    }
  ],
  "mitre_validation": {
    "alert_associated": [
      {% if upstream_mitre_techniques %}
      {% for tech in upstream_mitre_techniques %}
      "{{ tech.split('—')[0].split('-')[0].strip() }}"{% if not loop.last %},{% endif %}
      {% endfor %}
      {% endif %}
    ],
    "additional_techniques_from_retrieved_knowledge": [],
    "note": "Retrieved MITRE knowledge must not be promoted to alert-associated techniques unless explicitly supported by the upstream alert."
  },
  "playbook_assessment": {
    "applicable_playbook_found": {{ 'true' if playbook_assessment.applicable_playbook_found else 'false' }},
    "selected_playbook": {{ ('"' + playbook_assessment.selected_playbook + '"') if playbook_assessment.selected_playbook else 'null' }},
    "note": "No retrieved playbook should be recommended unless its applicability is supported by the alert evidence and/or explicit playbook mapping."
  },
  "ai_reasoning": "<Grounded reasoning explaining what was observed vs what is not established. Distinguish alert techniques from telemetry. Do not infer external destinations from localhost or TCP APS.>",
  "analyst_cautions": [
    "Do not treat retrieved threat-intelligence descriptions as proof that the described behavior occurred.",
    "Do not add MITRE techniques solely because they appear in retrieved documents.",
    "Do not infer external network communication or a destination from the TCP APS metric alone.",
    "Do not recommend an incident-response playbook unless its applicability is supported by the available evidence."
  ]
}

Return ONLY the raw JSON object without markdown formatting, code fences (no ```json), or extra conversational text.
